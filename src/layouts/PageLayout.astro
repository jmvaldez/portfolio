---
// The page frame (ticket 12 § The page frame; ticket 09 "The transition"): the outermost
// framed element of a page, and the ONE view-transition-name in the whole site
// (map Hazards: two elements sharing a `view-transition-name` silently skip the whole
// transition; a promoted window supplies its own name only in the click handler,
// Phase 10). `Frame` never sets one on its own, so this is the single static assignment.
import BaseLayout from './BaseLayout.astro';
import Frame from '~/components/chrome/Frame.astro';
import CloseBox from '~/components/chrome/CloseBox.astro';
import Breadcrumbs from '~/components/page/Breadcrumbs.astro';
import TaskbarStrip from '~/components/TaskbarStrip.astro';
import GridFloor from '~/components/GridFloor.astro';
import type { FsNode, FsTree } from '~/fs/types';

interface Props {
  title: string;
  description: string;
  node: FsNode;
  tree: FsTree;
  /** The masthead's filename (ticket 12 § Anatomy): the readme's name for a directory
   * that has one, the node's own name otherwise. Never the title. */
  filename: string;
}

const { title, description, node, tree, filename } = Astro.props;
---

<BaseLayout title={title} description={description} page>
  <div class="page-shell">
    <GridFloor />
    <Frame as="article" title={filename} headingLevel="h1" vtName="page-frame">
      <Fragment slot="controls">
        <CloseBox />
      </Fragment>
      <div class="page-content">
        <Breadcrumbs node={node} tree={tree} />
        <slot />
      </div>
    </Frame>
  </div>
  <TaskbarStrip tree={tree} onHome={false} />
</BaseLayout>

<style>
  .page-shell {
    /* `GridFloor` fills this in behind the frame (ticket 11 § "The 3D layer, without
       the island"), so the page frame, the linear layout masthead and (Phase 12) the
       WebGL scene all reference one shared floor concept. */
    position: relative;
    min-height: 100dvh;
    display: flex;
    justify-content: center;
    padding: 24px 16px;
  }

  /* Targets only the page frame itself, never a nested Section-style Frame (the
     children listing, Task 4.3) — `>` stops the selector at the direct child. */
  .page-shell > :global(.frame) {
    width: 100%;
    max-width: calc(72ch + 2 * var(--pad) + 2 * var(--border-w));
    min-height: 100dvh;
    /* Reserves room for the fixed taskbar strip Task 4.4 adds. */
    padding-bottom: calc(44px + env(safe-area-inset-bottom));
  }

  .page-content {
    padding: var(--pad);
  }
</style>
