---
// The page frame: the outermost framed element of a page and the only element in the
// site with a static `view-transition-name`. Two elements sharing a name silently skip
// the whole transition, so `Frame` never sets one on its own.
import BaseLayout from './BaseLayout.astro';
import Frame from '~/components/chrome/Frame.astro';
import CloseBox from '~/components/chrome/CloseBox.astro';
import Breadcrumbs from '~/components/page/Breadcrumbs.astro';
import TaskbarStrip from '~/components/TaskbarStrip.astro';
import GridFloor from '~/components/GridFloor.astro';
import type { FsNode, FsTree } from '~/fs/types';

interface Props {
  node: FsNode;
  tree: FsTree;
  /** The masthead's filename: the readme's name for a directory that has one, else the
   * node's own name. Never the title. */
  filename: string;
}

const { node, tree, filename } = Astro.props;
---

<BaseLayout node={node} tree={tree} page>
  <div class="page-shell">
    <GridFloor />
    <Frame as="article" title={filename} headingLevel="h1" vtName="page-frame">
      <Fragment slot="controls">
        <CloseBox />
      </Fragment>
      <div class="page-content">
        <Breadcrumbs node={node} tree={tree} />
        <slot />
      </div>
    </Frame>
  </div>
  <TaskbarStrip tree={tree} onHome={false} />
</BaseLayout>

<style>
  .page-shell {
    /* `GridFloor` fills this in behind the frame. */
    position: relative;
    min-height: 100dvh;
    display: flex;
    justify-content: center;
    padding: 24px 16px;
  }

  /* Targets only the page frame, not a nested Section-style Frame; `>` limits it to the
     direct child. */
  .page-shell > :global(.frame) {
    width: 100%;
    max-width: calc(72ch + 2 * var(--pad) + 2 * var(--border-w));
    min-height: 100dvh;
    /* Reserves room for the fixed taskbar strip. */
    padding-bottom: calc(44px + env(safe-area-inset-bottom));
  }

  .page-content {
    padding: var(--pad);
  }
</style>
