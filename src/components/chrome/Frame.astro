---
// The shared window/Section primitive (ticket 06 § chrome geometry; glossary
// "Page frame": the same object, grown to full height, is what a promoted window
// becomes). `vtName` sets `view-transition-name` on the root element only when the
// caller supplies one (ticket 09 hazard: a name applied statically to every frame
// makes two elements share it and silently skips the whole transition — this
// component never assigns one on its own).
interface Props {
  title: string;
  as?: 'section' | 'article' | 'div';
  titleId?: string;
  headingLevel?: 'h1' | 'h2';
  vtName?: string;
}

const { title, as = 'div', titleId, headingLevel = 'h2', vtName } = Astro.props;

const Tag = as;
const Heading = headingLevel;
---

<Tag class="frame" style={vtName ? `view-transition-name: ${vtName}` : undefined}>
  <div class="titlebar scan bloom">
    <Heading id={titleId}>{title}</Heading>
    <slot name="controls" />
  </div>
  <slot />
</Tag>
