---
// Shared window and Section primitive. `vtName` sets `view-transition-name` only when the
// caller passes one: a name applied to every frame would be shared by several elements
// and silently skip the whole transition.
interface Props {
  title: string;
  as?: 'section' | 'article' | 'div';
  titleId?: string;
  headingLevel?: 'h1' | 'h2';
  vtName?: string;
  /** Stable anchor id, used by the linear layout's Sections. */
  id?: string | undefined;
  /** Labels a `<section>` frame from its title heading; `article`/`div` callers omit it. */
  ariaLabelledby?: string;
}

const { title, as = 'div', titleId, headingLevel = 'h2', vtName, id, ariaLabelledby } = Astro.props;

const Tag = as;
const Heading = headingLevel;
---

<Tag
  class="frame"
  id={id}
  aria-labelledby={ariaLabelledby}
  style={vtName ? `view-transition-name: ${vtName}` : undefined}
>
  <div class="titlebar scan bloom">
    <Heading id={titleId}>{title}</Heading>
    <slot name="controls" />
  </div>
  <slot />
</Tag>
