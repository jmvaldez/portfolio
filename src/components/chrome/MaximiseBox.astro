---
// Link from a window or linear-layout Section to its node's page. The accessible name says
// where it goes ("maximise" would hide that); the glyph is `aria-hidden`.
interface Props {
  href: string;
  title: string;
}

const { href, title } = Astro.props;
---

<a class="ctl maxbox" href={href} aria-label={`Open ${title} page`}>
  <span aria-hidden="true">▢</span>
</a>
