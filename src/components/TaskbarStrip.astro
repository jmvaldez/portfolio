---
// The taskbar strip (ticket 11 § Taskbar strip, D11): the same fixed bottom strip on
// `/` (Phase 6) and on every content page. Launchers are root mount-table nodes with
// `launcher: true` (D11: "the mount table carries UI flags"), in mount order, except
// `app` nodes (`terminal.exe` lives under `/bin` and is a shell-only launcher, Phase
// 10) — there is no shell here to open a window in. Read straight off `mounts` rather
// than off the tree: only `RootFileMount` and `CollectionMount` ever carry `launcher`,
// which already excludes every `app`/`link`/`text`/`bin` mount. `onHome` picks the
// anchor's href: an in-page `#section` on `/` itself, `/#section` from a page. No
// gauges, no window buttons: both report live shell state and there is no shell on
// either of these surfaces.
import CrtToggle from '~/components/chrome/CrtToggle.astro';
import { mounts, type CollectionMount, type RootFileMount } from '~/fs/mounts';
import type { FsTree } from '~/fs/types';

interface Props {
  tree: FsTree;
  onHome: boolean;
}

const { tree, onHome } = Astro.props;

function isLauncherMount(mount: (typeof mounts)[number]): mount is RootFileMount | CollectionMount {
  return (mount.kind === 'file' || mount.kind === 'collection') && Boolean(mount.launcher);
}

const launchers = mounts
  .filter(isLauncherMount)
  .map((mount) => ({ path: mount.path, section: mount.section, title: tree[mount.path]?.title }))
  .filter(
    (launcher): launcher is { path: string; section: string; title: string } =>
      launcher.section !== undefined && launcher.title !== undefined,
  );
---

<nav class="frame taskbar-strip" aria-label="Taskbar">
  <ul class="taskbar-launchers">
    {launchers.map((launcher) => (
      <li>
        <a href={onHome ? `#${launcher.section}` : `/#${launcher.section}`}>{launcher.title}</a>
      </li>
    ))}
  </ul>
  <CrtToggle />
</nav>

<style>
  .taskbar-strip {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    height: calc(44px + env(safe-area-inset-bottom));
    padding-bottom: env(safe-area-inset-bottom);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding-inline: var(--pad);
    border-inline: none;
    border-bottom: none;
    border-radius: 0;
    z-index: 1;
  }

  .taskbar-launchers {
    display: flex;
    align-items: center;
    gap: 16px;
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-x: auto;
  }

  .taskbar-launchers a {
    color: inherit;
    text-decoration: none;
  }

  .taskbar-launchers a:hover {
    color: var(--accent);
  }
</style>
