---
// Fixed bottom strip shared by `/` and every content page. Launchers are the root mounts
// flagged `launcher: true`, in mount order; `app` nodes are excluded because there is no
// shell to open a window in. `onHome` picks the href: `#section` on `/` itself,
// `/#section` from any other page. No gauges or window buttons, since both need live
// shell state.
import CrtToggle from '~/components/chrome/CrtToggle.astro';
import { mounts, type CollectionMount, type RootFileMount } from '~/fs/mounts';
import { SHELL_QUERY } from '~/lib/breakpoint';
import { LAYOUT_OVERRIDE_KEY } from '~/lib/storage';
import type { FsTree } from '~/fs/types';

interface Props {
  tree: FsTree;
  onHome: boolean;
}

const { tree, onHome } = Astro.props;

// The Desktop control appears only on `/`, and only for a visitor above the breakpoint
// who chose the linear layout, so it offers a way back into the shell. Separate from
// `HeadGate.astro`, which is tight against its byte budget.
const desktopControlScript = `
var el=document.querySelector('[data-desktop-control]');
if(el){
try{
if(localStorage.getItem('${LAYOUT_OVERRIDE_KEY}')=='linear'&&matchMedia('${SHELL_QUERY}').matches){
el.removeAttribute('hidden');
}
}catch(e){}
el.addEventListener('click',function(){
try{localStorage.removeItem('${LAYOUT_OVERRIDE_KEY}')}catch(e){}
location.reload();
});
}`;

function isLauncherMount(mount: (typeof mounts)[number]): mount is RootFileMount | CollectionMount {
  return (mount.kind === 'file' || mount.kind === 'collection') && Boolean(mount.launcher);
}

const launchers = mounts
  .filter(isLauncherMount)
  .map((mount) => ({ path: mount.path, section: mount.section, title: tree[mount.path]?.title }))
  .filter(
    (launcher): launcher is { path: string; section: string; title: string } =>
      launcher.section !== undefined && launcher.title !== undefined,
  );
---

<nav class="frame taskbar-strip" aria-label="Taskbar">
  <ul class="taskbar-launchers">
    {launchers.map((launcher) => (
      <li>
        <a href={onHome ? `#${launcher.section}` : `/#${launcher.section}`}>{launcher.title}</a>
      </li>
    ))}
  </ul>
  {onHome && (
    <button type="button" data-desktop-control hidden>
      Desktop
    </button>
  )}
  <CrtToggle />
</nav>
{onHome &&
  // prettier-ignore
  <script is:inline set:html={desktopControlScript} />}

<style>
  .taskbar-strip {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    height: calc(44px + env(safe-area-inset-bottom));
    padding-bottom: env(safe-area-inset-bottom);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding-inline: var(--pad);
    border-inline: none;
    border-bottom: none;
    border-radius: 0;
    z-index: 1;
  }

  .taskbar-launchers {
    display: flex;
    align-items: center;
    gap: 16px;
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-x: auto;
  }

  .taskbar-launchers a {
    color: inherit;
    text-decoration: none;
  }

  .taskbar-launchers a:hover {
    color: var(--accent);
  }

  /* At 16px with 16px gaps the five launchers need 384px, so a phone clipped the last one
     to its first letter. Tighter spacing and type keep all five visible down to about
     340px; narrower than that, the list still scrolls. */
  @media (max-width: 440px) {
    .taskbar-launchers {
      gap: 8px;
      font-size: 14px;
    }
  }

  @media (max-width: 380px) {
    .taskbar-launchers {
      font-size: 13px;
    }
  }
</style>
