---
// A `Frame` rendered as a `<section>` anchored at `node.section`, labelled by its `h2`
// title (the node's filename). Its only control is a maximise box, shown when the node has
// a URL; there is never a close box because a Section is not a window.
import Frame from '~/components/chrome/Frame.astro';
import MaximiseBox from '~/components/chrome/MaximiseBox.astro';
import type { FsNode } from '~/fs/types';

interface Props {
  node: FsNode;
}

const { node } = Astro.props;
const titleId = `${node.section}-title`;
---

<Frame
  as="section"
  id={node.section}
  title={node.name}
  titleId={titleId}
  ariaLabelledby={titleId}
  headingLevel="h2"
>
  {node.url && (
    <Fragment slot="controls">
      <MaximiseBox href={node.url} title={node.title} />
    </Fragment>
  )}
  <div class="section-body">
    <slot />
  </div>
</Frame>

<style>
  .section-body {
    padding: var(--pad);
  }
</style>
