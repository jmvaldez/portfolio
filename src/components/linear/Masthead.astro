---
// The linear layout's masthead (ticket 11 § "What `/` is: one long scroll"): name and
// one-line role over the grid floor. Not a Section — no title bar, no bevel box, just
// text over `GridFloor`. Carries the page's single `h1` (Sections use `h2`, ticket 14
// § Shell structure convention mirrored here), `tabindex="-1"` so Phase 8 can move focus
// here on a live layout swap without adding a second focus target now.
import GridFloor from '~/components/GridFloor.astro';
---

<header class="masthead">
  <GridFloor />
  <h1 tabindex="-1">Joe Valdez</h1>
  <p class="tagline">Software engineer, moonlighting as a drone pilot.</p>
</header>

<style>
  .masthead {
    position: relative;
    overflow: hidden;
    width: 100%;
    padding: 64px var(--pad) 48px;
    text-align: center;
  }

  .masthead h1 {
    margin: 0 0 8px;
    font-size: 2rem;
    color: var(--accent);
    /* Slashed zero on chrome (ticket 13); this heading reads as chrome, not body copy. */
    font-feature-settings: 'zero';
  }

  .masthead h1:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .masthead .tagline {
    margin: 0;
    color: var(--ink);
  }
</style>
