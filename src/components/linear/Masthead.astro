---
// Name and one-line role over the grid floor; not a Section, so no title bar. Carries the
// page's single `h1` (Sections use `h2`). `tabindex="-1"` lets a live layout swap move
// focus here.
import GridFloor from '~/components/GridFloor.astro';
---

<header class="masthead">
  <GridFloor />
  <h1 tabindex="-1">Joe Valdez</h1>
  <p class="tagline">Software engineer, moonlighting as a drone pilot.</p>
</header>

<style>
  .masthead {
    position: relative;
    overflow: hidden;
    width: 100%;
    padding: 64px var(--pad) 48px;
    text-align: center;
  }

  .masthead h1 {
    margin: 0 0 8px;
    font-size: 2rem;
    color: var(--accent);
    /* Slashed zero: this heading reads as chrome, not body copy. */
    font-feature-settings: 'zero';
  }

  .masthead h1:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .masthead .tagline {
    margin: 0;
    color: var(--ink);
  }
</style>
