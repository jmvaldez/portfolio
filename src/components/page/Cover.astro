---
// A project's cover image (ticket 12 § Anatomy), when the entry sets one. Framed like
// chrome (`.frame`, reused verbatim, D14), never `.scan` (ticket 02: no scanlines over
// imagery any more than over prose). Explicit `width`/`height` so the image reserves its
// box before it loads, keeping CLS inside ticket 19's budget.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
}

const { image, alt } = Astro.props;
---

<div class="cover frame">
  <Image src={image} alt={alt} width={image.width} height={image.height} />
</div>

<style>
  .cover {
    margin: 0 0 var(--pad);
    overflow: hidden;
    line-height: 0;
  }

  .cover img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
