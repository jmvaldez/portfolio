---
// A project's cover image, framed like chrome but without scanlines. Explicit `width` and
// `height` reserve its box before load to avoid layout shift.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
}

const { image, alt } = Astro.props;
---

<div class="cover frame">
  <Image src={image} alt={alt} width={image.width} height={image.height} />
</div>

<style>
  .cover {
    margin: 0 0 var(--pad);
    overflow: hidden;
    line-height: 0;
  }

  .cover img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
