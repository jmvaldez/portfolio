---
// Rows of poster frame plus label, each linking out to the footage URL. No `<iframe>`
// embeds: a YouTube embed alone adds about 1 MB of third-party JS. A missing poster shows
// a framed "play" glyph.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface FootageEntry {
  label: string;
  url: string;
  poster?: ImageMetadata | undefined;
}

interface Props {
  items: FootageEntry[];
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <ul class="footage">
    {items.map((item) => (
      <li>
        <a class="footage-row" href={item.url} rel="noopener">
          {item.poster ? (
            <span class="footage-poster frame">
              <Image
                src={item.poster}
                alt=""
                width={item.poster.width}
                height={item.poster.height}
              />
            </span>
          ) : (
            <span class="footage-poster footage-placeholder frame" aria-hidden="true">
              &#9654;
            </span>
          )}
          <span class="footage-label">{item.label}</span>
        </a>
      </li>
    ))}
  </ul>
)}

<style>
  .footage {
    list-style: none;
    margin: 0 0 var(--pad);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5em;
  }

  .footage-row {
    display: flex;
    align-items: center;
    gap: 1em;
    color: inherit;
  }

  .footage-poster {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 60px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .footage-poster img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .footage-placeholder {
    color: var(--accent);
    font-size: 1.2em;
  }
</style>
