---
// Document head: title, description, canonical and OG tags, fonts, and the CRT script.
// `/` also gets Person JSON-LD.
import { Font } from 'astro:assets';
import CrtPrefScript from './CrtPrefScript.astro';
import { pageMeta } from '~/lib/meta';
import { SITE_NAME } from '~/lib/site';
import type { FsNode, FsTree } from '~/fs/types';
import '~/styles/global.css';

interface Props {
  /** Omitted for `/`, which gets the fixed root title and description. */
  node?: FsNode | undefined;
  tree: FsTree;
  /** Forwarded to `CrtPrefScript` to keep the inbound view transition. */
  page?: boolean;
}

const { node, tree, page = false } = Astro.props;

// `site-guard` fails the build if `Astro.site` is unset or localhost, so `!` is safe.
const meta = pageMeta(node, tree, Astro.site!.toString());

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE_NAME,
  jobTitle: 'Software Engineer',
  // Lorem placeholders, like the rest of the content.
  sameAs: ['https://github.com/joe-valdez-lorem', 'https://www.linkedin.com/in/joe-valdez-lorem'],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{meta.title}</title>
<meta name="description" content={meta.description} />
<link rel="canonical" href={meta.canonical} />
<meta property="og:title" content={meta.title} />
<meta property="og:description" content={meta.description} />
<meta property="og:url" content={meta.canonical} />
<meta property="og:image" content={meta.ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={meta.ogImageAlt} />
<meta property="og:type" content="website" />
<meta name="twitter:card" content="summary_large_image" />
{/* Only Regular is preloaded; Bold and Italic swap in on demand. */}
<Font cssVariable="--font-mono" preload={[{ weight: '400', style: 'normal' }]} />
{!node && (
  // `/` only. Data, not executable JS: `zero-js.spec.ts` excludes `application/ld+json`
  // from its inline-script byte count.
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
)}
<CrtPrefScript page={page} />
{/* Extra head content for a specific page (e.g. `/`'s `HeadGate`). */}
<slot />
