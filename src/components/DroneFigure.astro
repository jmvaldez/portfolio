---
// Build-time SVG of the procedural drone that `viewer.exe` orbits, with the viewer's
// crosshair and `.readout` drawn over it in plain HTML. Sharing the geometry keeps both
// surfaces from drifting; nothing here ships to the client.
import { renderDroneSvg } from '~/drone/svg';
import { DRONE_FIGURE_SIZE, featuredReadout } from '~/drone/readout';

const readout = await featuredReadout();
const svg = renderDroneSvg(DRONE_FIGURE_SIZE);
---

<div class="drone-figure" aria-hidden="true">
  <div class="drone-figure-svg" set:html={svg} />
  <div class="cross"></div>
  {readout && <div class="readout">{readout}</div>}
</div>

<style>
  /* Wireframe line art doesn't reliably survive forced colours, so the figure is dropped. */
  @media (forced-colors: active) {
    .drone-figure {
      display: none;
    }
  }

  .drone-figure {
    position: relative;
    width: 100%;
    max-width: 400px;
    aspect-ratio: 4 / 3;
    margin: 0 auto var(--pad);
    color: var(--ink);
  }

  .drone-figure-svg {
    display: block;
    width: 100%;
    height: 100%;
    line-height: 0;
  }

  .drone-figure-svg :global(svg) {
    width: 100%;
    height: 100%;
  }

  /* Crosshair and readout HUD layered over the SVG. */
  .cross {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .cross::before,
  .cross::after {
    content: '';
    position: absolute;
    background: var(--hud);
    opacity: 0.8;
  }

  .cross::before {
    left: 50%;
    top: calc(50% - 9px);
    width: 1px;
    height: 18px;
    transform: translateX(-0.5px);
  }

  .cross::after {
    top: 50%;
    left: calc(50% - 9px);
    height: 1px;
    width: 18px;
    transform: translateY(-0.5px);
  }

  .readout {
    position: absolute;
    left: 10px;
    bottom: 8px;
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--hud);
    font-variant-numeric: tabular-nums;
  }
</style>
