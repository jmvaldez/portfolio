---
// Inline pre-paint CRT preference script: a stored `vos:crt` value ('on' | 'off') wins,
// otherwise `forced-colors: active` or `prefers-contrast: more` default it off. Runs inline
// so the right treatment applies before first paint; a zero-JS page can't read
// `localStorage` any other way.
//
// Also owns the delegated click handler for `[data-crt-toggle]` buttons, which start
// `hidden` and are revealed only once this script has run, so a no-JS visitor never sees
// a dead toggle.
//
// Hand-terse on purpose: it must stay <= 600 bytes minified. Storage access is wrapped in
// try/catch because private browsing can throw on both `getItem` and `setItem`.
//
// `page` adds a `pagereveal` handler that keeps the view transition only when the visitor
// arrived from `/`; deep links and other arrivals get a hard cut. Astro doesn't evaluate
// `{}` expressions inside `is:inline` scripts, so the conditional part is built as a
// string here and the whole script is emitted via `set:html`, keeping a single inline
// script tag.
interface Props {
  page?: boolean;
}

const { page = false } = Astro.props;

const base = `try{var v=localStorage.getItem('vos:crt')}catch(e){}
if(v!='on'&&v!='off')v=matchMedia('(forced-colors:active),(prefers-contrast:more)').matches?'off':'on';
var d=document,h=d.documentElement;
h.dataset.crt=v;
d.addEventListener('click',function(e){var t=e.target.closest('[data-crt-toggle]');if(t){v=h.dataset.crt=='on'?'off':'on';h.dataset.crt=v;try{localStorage.setItem('vos:crt',v)}catch(e){}t.setAttribute('aria-pressed',''+(v=='on'))}});
d.addEventListener('DOMContentLoaded',function(){d.querySelectorAll('[data-crt-toggle]').forEach(function(el){el.removeAttribute('hidden')})});`;

// Only a same-origin referrer of exactly `/` keeps the transition.
const reveal = `
d.addEventListener('pagereveal',function(e){try{var u=new URL(d.referrer)}catch(x){}if(!u||u.origin!=location.origin||u.pathname!='/')e.viewTransition?.skipTransition()});`;

const script = page ? base + reveal : base;
---

<!-- prettier-ignore -->
<script is:inline set:html={script}></script>
