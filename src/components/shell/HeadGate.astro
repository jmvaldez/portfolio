---
// Blocking inline script that runs before first paint on `/` only and decides between
// boot, restore, and staying on the linear layout. Rendered unconditionally; `Head.astro`
// includes it only for `/`.
//
// Has its own inline-JS budget (<= 1.5 KB), separate from `CrtPrefScript`'s, and is
// hand-terse for the same reason. Must come after `CrtPrefScript` in document order
// because it reads `html[data-crt]`, which that script sets synchronously.
//
// The breakpoint query and storage keys are interpolated from `~/lib/breakpoint` and
// `~/lib/storage`: an `is:inline` script can't import, and this keeps each literal in
// one place.
//
// The script runs while `<head>` is still parsing, before `BootScreen`'s `[data-slot]`
// spans and `#restore-line` exist. Only the `<html>` class and dataset work can run
// immediately; filling those elements waits for `DOMContentLoaded`.
import { SHELL_QUERY } from '~/lib/breakpoint';
import { LAYOUT_OVERRIDE_KEY, BOOTED_KEY, LAYOUT_KEY } from '~/lib/storage';

// `/` always cuts the view transition: it shows the linear layout and swaps in the shell
// moments later, so morphing a page frame into that would look like a glitch.
const reveal = `d.addEventListener('pagereveal',function(e){e.viewTransition?.skipTransition()});`;

// `g` is a storage getter shared by both storage kinds and `c` is
// `documentElement.classList`; the aliases keep the script under its byte budget.
const script = `
var d=document,h=d.documentElement,c=h.classList,ls=localStorage,ss=sessionStorage;
function g(s,k){try{return s.getItem(k)}catch(e){}}
${reveal}
if(g(ls,'${LAYOUT_OVERRIDE_KEY}')=='linear'||!matchMedia('${SHELL_QUERY}').matches)return;
c.add('shell');
var rm=matchMedia('(prefers-reduced-motion: reduce)').matches;
if(rm)c.add('reduced');
var booted=g(ss,'${BOOTED_KEY}');
d.addEventListener('DOMContentLoaded',function(){
var ph=d.querySelector('[data-slot="phosphor"]');
if(ph&&h.dataset.crt=='off')ph.textContent='BYPASSED';
var vu=d.querySelector('[data-slot="vector-unit"]');
if(vu&&(rm||!window.WebGL2RenderingContext))vu.textContent='STANDBY';
if(booted){
var n=0;
try{var raw=g(ss,'${LAYOUT_KEY}');if(raw)n=(JSON.parse(raw).windows||[]).length}catch(e){}
var t=n==0?'DESKTOP RESTORED':n+' WINDOW'+(n==1?'':'S')+' RESTORED';
var el=d.getElementById('restore-line');
if(el)el.textContent='RESUME \\u00b7 '+t;
}
});
if(booted){
c.add('restore');
}else{
try{ss.setItem('${BOOTED_KEY}','1')}catch(e){}
c.add('boot');
h.dataset.bootAt=''+performance.now();
['keydown','pointerdown'].forEach(function(t){window.addEventListener(t,sk,true)});
}
function sk(e){
if(!c.contains('boot')||c.contains('shell-ready'))return;
e.preventDefault();
e.stopImmediatePropagation();
c.add('boot-skipped');
}
setTimeout(function(){if(!c.contains('shell-ready'))c.remove('shell','boot','restore')},6000);
`;

// `is:inline` scripts run as plain top-level scripts (not modules), so the early
// `return` above needs a function body to return out of.
const wrapped = `(function(){${script}})();`;
---

<!-- prettier-ignore -->
<script is:inline set:html={wrapped}></script>
