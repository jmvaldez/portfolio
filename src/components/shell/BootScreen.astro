---
// Server-rendered boot log revealed purely by CSS timing; `shell.css` shows it only while
// `html.boot` is set. `HeadGate.astro`'s inline script fills the two `[data-slot]` spans
// with real state and later sets `html.shell-ready`, which reveals the final line's `OK`.
// `aria-hidden` throughout: the island makes the single desktop-ready announcement.
//
// The mount line lists the real `collection` mounts (`/projects`, `/drones`). The `pages`
// collection has no directory of its own, so it never appears.
import { mounts, type CollectionMount } from '~/fs/mounts';

function isCollectionMount(mount: (typeof mounts)[number]): mount is CollectionMount {
  return mount.kind === 'collection';
}

const collectionPaths = mounts.filter(isCollectionMount).map((mount) => mount.path);
const mountLine = `MOUNTING ${collectionPaths.join(' ')} .. OK`;
---

<div id="boot" class="scan" aria-hidden="true">
  <pre class="boot-log bloom">
<span class="boot-line boot-line-1 boot-header">VALDEZ-OS 1.0 &middot; BIOS REV 7.0</span>
<span class="boot-line boot-line-2">MEMORY TEST ............ 640K OK</span>
<span class="boot-line boot-line-3">PHOSPHOR ............... <span data-slot="phosphor">GREEN/AMBER OK</span></span>
<span class="boot-line boot-line-4">VECTOR UNIT ............ <span data-slot="vector-unit">ONLINE</span></span>
<span class="boot-line boot-line-5">{mountLine}</span>
<span class="boot-line boot-line-6">LOADING DESKTOP ........ <span class="loading-ok">OK</span></span></pre>
  <p class="boot-skip bloom">PRESS ANY KEY TO SKIP</p>
</div>

<style>
  #boot {
    position: fixed;
    inset: 0;
    /* Above the taskbar strip's `z-index: 1`, in case that strip is ever visible. */
    z-index: 2;
    background: #000;
    color: var(--ink);
    font-family: var(--font-mono);
    /* Slashed zero: this is chrome/log output, not body copy. */
    font-feature-settings: 'zero';
  }

  .boot-log {
    margin: 0;
    padding: var(--pad);
    white-space: pre-wrap;
  }

  .boot-header {
    color: var(--accent);
  }

  .boot-line {
    display: block;
    opacity: 0;
    animation: boot-reveal 1ms linear both;
  }

  .boot-line-1 {
    animation-delay: 0ms;
  }
  .boot-line-2 {
    animation-delay: 80ms;
  }
  .boot-line-3 {
    animation-delay: 160ms;
  }
  .boot-line-4 {
    animation-delay: 240ms;
  }
  .boot-line-5 {
    animation-delay: 320ms;
  }
  .boot-line-6 {
    animation-delay: 400ms;
  }

  @keyframes boot-reveal {
    to {
      opacity: 1;
    }
  }

  /* Reduced motion and skipping (`boot-skipped`) both jump to the fully revealed log by
     removing the delays; neither adds an animation or changes the CRT treatment. */
  :global(html.reduced) #boot .boot-line,
  :global(html.boot-skipped) #boot .boot-line {
    animation: none;
    opacity: 1;
  }

  /* The final line's `OK` appears only once the island has taken over. */
  .loading-ok {
    visibility: hidden;
  }

  :global(html.shell-ready) #boot .loading-ok {
    visibility: visible;
  }

  .boot-skip {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    margin: 0;
    padding: var(--pad);
    color: var(--accent);
    text-align: center;
  }
</style>
