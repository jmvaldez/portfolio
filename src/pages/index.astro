---
// `/` (ticket 09, ticket 11): server-renders the linear layout, the one artifact serving
// the mobile experience, the no-JS visitor and the crawler. `HeadGate` decides, before
// first paint, whether it stays that way or hands off to `BootScreen`/`RestoreLine` and
// then `Shell` — the `client:only` React island (ticket 01, D9: `tree` arrives as
// serialised props, never a fetch).
import BaseLayout from '~/layouts/BaseLayout.astro';
import LinearLayout from '~/components/linear/LinearLayout.astro';
import TaskbarStrip from '~/components/TaskbarStrip.astro';
import HeadGate from '~/components/shell/HeadGate.astro';
import BootScreen from '~/components/shell/BootScreen.astro';
import RestoreLine from '~/components/shell/RestoreLine.astro';
import Shell from '~/shell/Shell';
import { getTree } from '~/fs/load';
import { renderDroneSvg } from '~/drone/svg';
import { DRONE_FIGURE_SIZE, featuredReadout } from '~/drone/readout';

const tree = await getTree();
// D19: the shell's fallback for `viewer.exe`, rendered here so it costs the island no
// three import (same source as the linear layout's figure).
const droneSvg = renderDroneSvg(DRONE_FIGURE_SIZE);
const droneReadout = await featuredReadout();
---

<BaseLayout tree={tree}>
  <Fragment slot="head">
    <HeadGate />
  </Fragment>
  <LinearLayout tree={tree} />
  <BootScreen />
  <RestoreLine />
  <TaskbarStrip tree={tree} onHome={true} />
  <Shell client:only="react" tree={tree} droneSvg={droneSvg} droneReadout={droneReadout} />
</BaseLayout>
