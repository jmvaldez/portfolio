{
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/build-resume-pdf.mjs",
    "build:site": "astro build",
    "preview": "astro preview --port 4321",
    "check": "astro check",
    "sync": "astro sync",
    "lint": "astro sync && eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fonts:subset": "python3 scripts/subset-fonts.py",
    "verify": "pnpm lint && pnpm check && pnpm test && pnpm build && pnpm test:e2e"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.3.5",
    "fontkit": "^2.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "satori": "^0.33.5",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@ibm/plex-mono": "^2.5.0",
    "@playwright/test": "^1.63.0",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
